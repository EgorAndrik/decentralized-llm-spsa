# Copy to .env in the repository root and use your own credentials.
LLM_BASE_URL=https://api.groq.com/openai/v1
API_KEY=
LLM_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
LLM_JUDGE_MODEL=openai/gpt-oss-120b
LLM_MAX_CALLS=2
ROUTING_CONTROLLERS=3

# Optional settings. Token prices are USD per million input and output tokens.
# LLM_ALLOWED_HOSTS=
# LLM_MAX_TOKENS=512
# LLM_TIMEOUT_SECONDS=60
# LLM_TOKEN_PRICES='{"openai/gpt-oss-20b":[0.075,0.30],"openai/gpt-oss-120b":[0.15,0.60]}'
# TAVILY_API_KEY=
# ROUTING_DATABASE_URL=
